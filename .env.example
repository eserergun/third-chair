# Build-time override of the contract the site talks to (tests only). Default: deployments/testnet.json
VITE_CONTRACT_ID=
# Optional Soroban RPC URL override (dedicated provider). Default comes from the deployment JSON.
VITE_RPC_URL=
# Node/scripts alias for the same override (deploy, keeper, upgrade, agents).
STANDOFF_RPC_URL=
# Admin secret for scripts/deploy.ts, upgrade.ts, and the keeper workflow. Never commit a real value.
# Must be the S... secret for the existing admin public key GC2SWUC254XOXW6PG4A7ZBRIMSQAS2OS73BSN76HG5OWYP6TJAJG43C3 (testnet).
STANDOFF_ADMIN_SECRET=
