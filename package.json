{
  "name": "third-chair",
  "private": true,
  "version": "0.1.0",
  "description": "Third Chair: a three-seat western standoff, fully on-chain on Stellar testnet.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:skill": "tsx scripts/gen-skill.ts",
    "predev": "tsx scripts/gen-skill.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/gen-skill.ts",
    "build": "vite build",
    "preview": "vite preview",
